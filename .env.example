# Entra ID-appregistrering (se README)
MS_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# "consumers" för privat Microsoft-konto (outlook.com), annars din tenant-GUID
MS_TENANT_ID=consumers

ANTHROPIC_API_KEY=sk-ant-...

DATABASE_URL=postgresql+psycopg://mailroom:mailroom@db:5432/mailroom

# True = klassificera & logga men rör aldrig mailen. Kör så första veckorna.
SHADOW_MODE=true
GRAPH_POLL_MINUTES=5

# Valfria notiser
NTFY_URL=
HA_WEBHOOK_URL=
